# ==============================================================================
# exnoria — CX Intelligence Engine
# Environment variables
#
# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.
#
# [REQUIRED] = must be set before docker compose up
# [GENERATED] = must be generated once using the command shown
# [DEFAULT]   = safe to leave as-is for local development
# ==============================================================================


# ------------------------------------------------------------------------------
# Project Identity
# Used to namespace containers, databases, and branding for multi-instance support
# ------------------------------------------------------------------------------

# [DEFAULT] Project identifier — used for container names and DB namespace
# Change this when deploying a second instance on the same host
# PROJECT_ID=exnoria

# [OPTIONAL] Subtitle for dashboard branding (e.g., "Bajio Outbound")
# PROJECT_SUBTITLE=


# ------------------------------------------------------------------------------
# Postgres
# Shared by n8n and the filter service
# ------------------------------------------------------------------------------

# [REQUIRED] Password for the exnoria Postgres user
# Use a strong password — this database holds n8n credentials and audit logs
POSTGRES_PASSWORD=

# [DEFAULT] Database name
POSTGRES_DB=exnoria


# ------------------------------------------------------------------------------
# n8n
# ------------------------------------------------------------------------------

# [REQUIRED] [GENERATED] Encryption key for credentials stored inside n8n
#
# Generate with:
#   openssl rand -hex 32
#
# !! CRITICAL: Generate this once, paste the result below, and never change it.
# !! If this value changes after n8n has stored credentials, those credentials
# !! become permanently unreadable and workflows that depend on them will break.
# !! Back this value up somewhere safe (password manager, secrets vault).
#
N8N_ENCRYPTION_KEY=

# [REQUIRED] API key for n8n REST API
# Used by external services to trigger workflows, manage credentials, etc.
# Generate in: n8n UI → Settings → API Key
N8N_API_KEY=

# [DEFAULT] n8n host — localhost for local dev, your domain in production
N8N_HOST=localhost

# [DEFAULT] Protocol — http for local dev, https in production
N8N_PROTOCOL=http

# [DEFAULT] Public webhook URL — n8n uses this to construct webhook URLs in the UI
# Local dev:   http://localhost:5678
# Production:  https://your-domain.com
N8N_WEBHOOK_URL=http://localhost:5678


# ------------------------------------------------------------------------------
# Meta WhatsApp Business API
# Used by W3 · sal.contact.prioritize
# Credentials are stored in n8n — these vars are read by workflows via $env
# ------------------------------------------------------------------------------

# [REQUIRED] System User permanent token from Meta Business Manager
# business.facebook.com/settings/system-users → Generate New Token → Never expires
# Scopes required: whatsapp_business_messaging, whatsapp_business_management
META_WA_TOKEN=

# [REQUIRED] Phone Number ID of your WhatsApp Business sender number
# Found in: Meta Business Suite → WhatsApp → API Setup → Phone Number ID
# This is a numeric ID (e.g. 968414346359263), NOT the phone number itself
META_PHONE_NUMBER_ID=

# [REQUIRED] Recipient WhatsApp number for SDR notifications (international format)
# MVP: your own number. Add more recipients when HITL is introduced.
SDR_WHATSAPP_NUMBER=


# ------------------------------------------------------------------------------
# HubSpot
# Used by W1 · acq.lead.score, W2 · sal.sequence.enroll, W3 · sal.contact.prioritize
# Token is stored as an n8n credential — this var is passed via docker-compose
# ------------------------------------------------------------------------------

# [REQUIRED] HubSpot Private App token
# HubSpot → Settings → Integrations → Private Apps → Create private app
# Scopes required:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
HUBSPOT_PRIVATE_APP_TOKEN=

# [REQUIRED] Your HubSpot portal ID
# Found in: HubSpot → Settings → Account → Account Details
# Used to construct contact URLs in WhatsApp notifications
HUBSPOT_PORTAL_ID=

# [REQUIRED] HubSpot Developer API Key
# Used for app management and developer-level operations
# Found in: HubSpot Developer Portal → Apps → Manage Apps
HUBSPOT_DEVELOPER_API_KEY=

# [REQUIRED] HubSpot Personal Access Key
# Used for CLI-based development and specific personal integrations
# Found in: HubSpot → Settings → Integrations → Private Apps
HUBSPOT_PERSONAL_ACCESS_KEY=


# ------------------------------------------------------------------------------
# Filter service — layers/orchestration/filter/
# ------------------------------------------------------------------------------

# [DEFAULT] Port the filter HTTP service listens on
FILTER_PORT=3000

# [DEFAULT] Internal n8n URL used by the filter to trigger workflows
# Do not change for Docker Compose — uses the internal exnoria_internal network
N8N_BASE_URL=http://n8n:5678

# [REQUIRED] Telegram chat ID para notificaciones HITL al operador
# Get it: message @userinfobot in Telegram → copy the "Id" value
#
# ⚠️  DEV NOTE — Colisión de notificaciones en entorno local:
# La arquitectura tiene DOS canales de Telegram independientes:
#   1. sendReply(contact_id)  → Cognitive Layer → responde al *cliente*
#   2. notifyOperator(...)    → Filter Service  → avisa al *operador* (este var)
# En producción son chats distintos. En dev local, si este chat_id y el del
# contacto apuntan al mismo chat personal, recibirás DOS mensajes por acción HITL.
# Esto NO es un bug — es la arquitectura correcta. Los dos canales coexisten.
TELEGRAM_OPERATOR_CHAT_ID=

# [REQUIRED] URL pública del dashboard — incluida en los links del mensaje HITL de Telegram
#
# ⚠️  PRODUCCIÓN: DEBE ser un dominio o IP resoluble externamente (nunca localhost).
# Si apunta a localhost, los links del bot de Telegram NO funcionarán desde el celular.
# Opciones: tu dominio real, IP pública, o túnel como ngrok (https://xxx.ngrok.io)
# El Filter Service emite un logger.warn() al arrancar si detecta localhost fuera de dev.
#
# Local dev:    http://localhost:4000
# Producción:   https://dashboard.yourdomain.com
DASHBOARD_URL=http://localhost:4000

# [REQUIRED] Google Sheets ID for the COM content calendar
# Used by W-COM-1 · com.content.publish to read scheduled social media content
COM_CONTENT_SHEET_ID=

# [REQUIRED] Threads API Access Token
# Used by W-COM-1 · com.content.publish for the Threads Post node
THREADS_ACCESS_TOKEN=

# ==============================================================================
# Cognitive layer — packages/cognitive/
# Provider-agnostic LLM configuration (OpenAI-compatible API)
# Supports both single-agent and multi-agent modes with automatic fallback
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary LLM Provider (Groq) — REQUIRED
# Used for single-agent mode and as base for multi-agent specialists
# ------------------------------------------------------------------------------

# [REQUIRED] Groq API key
LLM_API_KEY=

# [DEFAULT] Groq base URL (OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1

# PRIMARY MODEL: llama-3.3-70b-versatile (supports tool calling, free tier: 1000 req/day)
LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Multi-Agent Specialist Configuration (Groq)
# Only used when AGENT_MODE=multi
# ------------------------------------------------------------------------------

# Coordinator model (routes events to specialists)
LLM_COORDINATOR_MODEL=llama-3.3-70b-versatile

# Specialist models (execute actions per cluster)
LLM_ACQSAL_MODEL=llama-3.3-70b-versatile
LLM_LIFECYCLE_MODEL=llama-3.3-70b-versatile
LLM_ESCALATION_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Backup/Fallback LLM Provider (OpenRouter) — OPTIONAL
# Automatically used when Groq fails (rate limit, error, etc.)
# ------------------------------------------------------------------------------

# [OPTIONAL] OpenRouter API key (required for fallback)
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# [DEFAULT] OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# FALLBACK MODEL: llama-3.3-70b-instruct:free (supports tool calling, free tier: 200 req/day)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# Agent Mode Configuration
# ------------------------------------------------------------------------------

# Agent mode: 'single' or 'multi'
# - single: Uses LLM_MODEL, LLM_BASE_URL (with OpenRouter fallback)
# - multi: Uses specialist models per cluster (Groq only for now)
AGENT_MODE=single

# [REQUIRED] Google API key for text-embedding-004 (semantic memory)
# Used by the cognitive layer to generate and search vector embeddings
# console.cloud.google.com → APIs & Services → Credentials → Create API Key
# Enable: Generative Language API
EMBEDDING_API_KEY=

# [REQUIRED] Telegram Bot token — the cognitive layer's inbound channel
# Create via @BotFather in Telegram → /newbot → copy the HTTP API token
# The bot uses long-polling (outbound only) — no firewall port forwarding needed
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# [OPTIONAL] PostHog configuration for product analytics MCP tools
# Get your API key from https://us.posthog.com/settings/user-api-keys?preset=mcp_server
# The mapping requires posthog_distinct_id = contact_id
POSTHOG_AUTH_HEADER="Bearer phx_your_api_key_here"
POSTHOG_PROJECT_ID=""
POSTHOG_HOST="https://app.posthog.com"
POSTHOG_PROJECT_TOKEN=""

# Legacy (deprecated)
# POSTHOG_API_KEY=""



# ------------------------------------------------------------------------------
# Dashboard — layers/dashboard/
# ------------------------------------------------------------------------------

# [OPTIONAL] Project subtitle shown in dashboard branding
# Useful to distinguish instances (e.g. "Bajio Outbound", "LATAM Support")
# NEXT_PUBLIC_PROJECT_SUBTITLE=

# Host port mapping for the Next.js UI
DASHBOARD_PORT=4000

# [REQUIRED] Admin password for dashboard login
# This password is automatically used to seed the admin account during `make up`
# if DASHBOARD_ADMIN_PASSWORD is set before migrations run.
#
# If left blank and migrations have already run, use POST /api/bootstrap/admin-init
# with { "password": "your-secure-password" } to set it later (one-time call only).
#
# Minimum length: 8 characters
DASHBOARD_ADMIN_PASSWORD=change_this_to_a_secure_dashboard_password

# Secret string used to sign identical auth cookies (recommend: run `openssl rand -hex 32`)
DASHBOARD_AUTH_SECRET=change_this_to_a_secret_auth_hash


# ------------------------------------------------------------------------------
# Deployment
# Used by deploy/init.sh and docker-compose overrides for VPS and Edge environments
# ------------------------------------------------------------------------------

# [VPS/EDGE] Public hostname for n8n — must match DNS A record
# Local dev: not required (uses localhost:5678 directly)
# VPS example:  n8n.yourdomain.com
# Edge example: xnoria-n8n.local
# N8N_HOST=n8n.yourdomain.com

# [VPS/EDGE] Public hostname for the dashboard — must match DNS A record
# VPS example:  dashboard.yourdomain.com
# Edge example: xnoria.local
# DASHBOARD_HOST=dashboard.yourdomain.com

# [REQUIRED for backup.sh] Passphrase for AES-256 backup encryption
# Set before running ./deploy/backup.sh or ./deploy/restore.sh
# Never commit this value to source control
# BACKUP_PASSPHRASE=

# [OPTIONAL] S3-compatible bucket for offsite backup upload
# Requires: aws CLI installed and S3 credentials set
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
