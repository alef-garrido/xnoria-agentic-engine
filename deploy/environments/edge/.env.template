# ==============================================================================
# Xnoria — Edge Device Environment Template
# deploy/environments/edge/.env.template
#
# Used by: ./deploy/init.sh edge
# Target: Intel NUC, Beelink mini PC, Raspberry Pi 4/5 (4GB+ RAM)
# Local hostname: xnoria.local (mDNS via Avahi) or static IP
# ==============================================================================

# ------------------------------------------------------------------------------
# Postgres
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=
POSTGRES_DB=exnoria

# ------------------------------------------------------------------------------
# n8n
# Edge: served via internal Caddy with self-signed or mDNS hostname
# ------------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
N8N_API_KEY=
N8N_HOST=xnoria-n8n.local
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://xnoria-n8n.local

# ------------------------------------------------------------------------------
# Meta WhatsApp
# ------------------------------------------------------------------------------
META_WA_TOKEN=
META_PHONE_NUMBER_ID=
SDR_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# HubSpot
# ------------------------------------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_DEVELOPER_API_KEY=
HUBSPOT_PERSONAL_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Filter service
# ------------------------------------------------------------------------------
FILTER_PORT=3000
N8N_BASE_URL=http://n8n:5678
TELEGRAM_OPERATOR_CHAT_ID=
DASHBOARD_URL=https://xnoria.local
COM_CONTENT_SHEET_ID=
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Cognitive layer
# ------------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_COORDINATOR_MODEL=llama-3.3-70b-versatile
LLM_ACQSAL_MODEL=llama-3.3-70b-versatile
LLM_LIFECYCLE_MODEL=llama-3.3-70b-versatile
LLM_ESCALATION_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
AGENT_MODE=single
EMBEDDING_API_KEY=
TELEGRAM_BOT_TOKEN=
POSTHOG_AUTH_HEADER=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_TOKEN=

# ------------------------------------------------------------------------------
# Dashboard
# Strict HTTPS-only cookie setting
# ------------------------------------------------------------------------------
DASHBOARD_PORT=4000
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_AUTH_SECRET=

# ------------------------------------------------------------------------------
# Deployment — Edge
# mDNS hostnames (resolved via Avahi on Linux, Bonjour on macOS/Windows)
# To override: set your static IP or router-level hostname instead
# ------------------------------------------------------------------------------
N8N_HOST=xnoria-n8n.local
DASHBOARD_HOST=xnoria.local

# Memory limits are set in docker-compose.override.yml
# Optimized defaults for 4GB RAM devices

# Backup configuration
BACKUP_PASSPHRASE=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
