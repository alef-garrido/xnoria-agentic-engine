# ==============================================================================
# Xnoria — Local Development Environment Template
# deploy/environments/local/.env.template
#
# Used by: ./deploy/init.sh local
# Copy this to .env — never commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Postgres
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=
POSTGRES_DB=exnoria

# ------------------------------------------------------------------------------
# n8n
# NOTE: Local dev exposes n8n directly at localhost:5678
# External webhooks (from Meta, HubSpot, etc.) require a tunnel: ngrok, cloudflared
# ------------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
N8N_API_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# ------------------------------------------------------------------------------
# Meta WhatsApp
# ------------------------------------------------------------------------------
META_WA_TOKEN=
META_PHONE_NUMBER_ID=
SDR_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# HubSpot
# ------------------------------------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_DEVELOPER_API_KEY=
HUBSPOT_PERSONAL_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Filter service
# ------------------------------------------------------------------------------
FILTER_PORT=3000
N8N_BASE_URL=http://n8n:5678
TELEGRAM_OPERATOR_CHAT_ID=
DASHBOARD_URL=http://localhost:4000
COM_CONTENT_SHEET_ID=
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Cognitive layer
# ------------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_COORDINATOR_MODEL=llama-3.3-70b-versatile
LLM_ACQSAL_MODEL=llama-3.3-70b-versatile
LLM_LIFECYCLE_MODEL=llama-3.3-70b-versatile
LLM_ESCALATION_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
AGENT_MODE=single
EMBEDDING_API_KEY=
TELEGRAM_BOT_TOKEN=
POSTHOG_AUTH_HEADER=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_TOKEN=

# ------------------------------------------------------------------------------
# Dashboard
# ------------------------------------------------------------------------------
DASHBOARD_PORT=4000
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_AUTH_SECRET=

# ------------------------------------------------------------------------------
# Deployment settings (local)
# Not used for local dev — N8N_HOST and DASHBOARD_HOST are localhost
# ------------------------------------------------------------------------------
# BACKUP_PASSPHRASE=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
