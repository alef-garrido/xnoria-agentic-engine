# ==============================================================================
# Exnoria — VPS Environment Template
# deploy/environments/vps/.env.template
#
# Used by: ./deploy/init.sh vps
# Target: Ubuntu 24.04 LTS, public domain, HTTPS via Caddy + Let's Encrypt
# ==============================================================================

# ------------------------------------------------------------------------------
# Postgres
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=
POSTGRES_DB=exnoria

# ------------------------------------------------------------------------------
# n8n
# Production: HTTPS via Caddy reverse proxy
# N8N_HOST and N8N_WEBHOOK_URL must match your actual domain
# ------------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=
N8N_API_KEY=
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.yourdomain.com

# ------------------------------------------------------------------------------
# Meta WhatsApp
# ------------------------------------------------------------------------------
META_WA_TOKEN=
META_PHONE_NUMBER_ID=
SDR_WHATSAPP_NUMBER=

# ------------------------------------------------------------------------------
# HubSpot
# ------------------------------------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_DEVELOPER_API_KEY=
HUBSPOT_PERSONAL_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Filter service
# Not exposed externally — internal network only
# ------------------------------------------------------------------------------
FILTER_PORT=3000
N8N_BASE_URL=http://n8n:5678
TELEGRAM_OPERATOR_CHAT_ID=
DASHBOARD_URL=https://dashboard.yourdomain.com
COM_CONTENT_SHEET_ID=
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Cognitive layer
# ------------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_COORDINATOR_MODEL=llama-3.3-70b-versatile
LLM_ACQSAL_MODEL=llama-3.3-70b-versatile
LLM_LIFECYCLE_MODEL=llama-3.3-70b-versatile
LLM_ESCALATION_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
AGENT_MODE=single
EMBEDDING_API_KEY=
TELEGRAM_BOT_TOKEN=
POSTHOG_AUTH_HEADER=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_TOKEN=

# ------------------------------------------------------------------------------
# Dashboard
# Strict auth: HTTPS-only cookie
# ------------------------------------------------------------------------------
DASHBOARD_PORT=4000
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_AUTH_SECRET=

# ------------------------------------------------------------------------------
# Deployment — VPS
# Required for Caddy to provision TLS certificates
# Must match the DNS A records pointing to this VPS
# ------------------------------------------------------------------------------
N8N_HOST=n8n.yourdomain.com
DASHBOARD_HOST=dashboard.yourdomain.com

# Backup configuration
BACKUP_PASSPHRASE=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
