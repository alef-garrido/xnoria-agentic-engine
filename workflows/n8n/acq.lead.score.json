    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nreturn {\n  json: {\n    contact_id: body.contact_id,\n    email: body.payload?.email || body.email,\n    source: body.payload?.source || 'unknown',\n    signal_id: body.signal_id || null,\n    signal_severity: body.signal_severity || 0,\n    session_id: body.session_id\n  }\n};"
      },
      "id": "normalize-lead-code",
      "name": "NormalizeLead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $json.source;\nconst severity = $json.signal_severity || 0;\n\n// Rule-based scoring\nconst sourceScore = {\n  organic: 80,\n  referral: 90,\n  paid: 60,\n  unknown: 40\n}[source] || 40;\n\nconst severityBoost = Math.round(severity * 20);\nconst score = Math.min(sourceScore + severityBoost, 100);\n\nconst tags = [];\nif (score >= 80) tags.push('hot-lead');\nelse if (score >= 60) tags.push('warm-lead');\nelse tags.push('cold-lead');\n\nif (source === 'referral') tags.push('referral-source');\n\nreturn {\n  json: {\n    ...$json,\n    lead_score: score,\n    tags\n  }\n};"
      },
      "id": "score-lead-code",
      "name": "ScoreLeadLogic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $json.contact_id }}",
        "authentication": "credential",
        "credentialSet": {
