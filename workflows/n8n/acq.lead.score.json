              "value": "={{ $json.lead_score }}"
            },
            {
              "name": "properties.hs_lead_status",
              "value": "={{ $json.lead_score >= 80 ? 'IN_PROGRESS' : 'NEW' }}"
            },
            {
              "name": "properties.xnoria_tags",
              "value": "={{ $json.tags.join(',') }}"
            }
          ]
