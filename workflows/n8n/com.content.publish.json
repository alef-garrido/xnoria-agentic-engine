      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "com-content-publish",
        "options": {}
      },
      "id": "webhook-com-content-publish",
      "name": "Filter Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        400
      ],
      "webhookId": "com-content-publish"
    },
    {
      "parameters": {
        "jsCode": "// Exnoria - com.content.publish\n// Load content calendar config from env.\n// Runs on schedule OR on-demand from filter dispatch.\n// EXCEPTION: This workflow retains its autonomous schedule — content publishing is time-based.\n// The filter webhook is a secondary entry point for on-demand cognitive triggers.\n\nreturn [{\n  json: {\n    spreadsheetId: $env.COM_CONTENT_SHEET_ID,\n    sheetName: 'ContentCalendar',\n    timezone: 'America/Mexico_City'\n  }\n}];"
      },
      "id": "config-loader-com-1",
      "name": "ConfigLoader",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "={{ $json.sheetName }}",
          "mode": "name"
        },
        "operation": "read",
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Status",
              "lookupValue": "Scheduled"
            }
          ]
        }
      },
      "id": "fetch-content-com-1",
      "name": "Fetch Content",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "filter-scheduled-id",
              "leftValue": "={{ $json.Status }}",
              "rightValue": "Scheduled",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-scheduled-com-1",
      "name": "Filter Scheduled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.Content }}",
        "postAs": "person",
        "resource": "post",
        "person": "urn:li:person:me"
      },
      "id": "linkedin-post-com-1",
      "name": "LinkedIn Post",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [
        1060,
        160
      ]
    },
    {
      "parameters": {
        "options": {},
        "queryParametersUi": {
          "parameter": [
            {
              "name": "caption",
              "value": "={{ $node['Fetch Content'].json.Content }}"
            },
            {
              "name": "image_url",
              "value": "={{ $node['Fetch Content'].json.ImageUrl }}"
            }
          ]
        },
        "httpRequestMethod": "POST",
        "graphApiVersion": "v18.0",
        "node": "me",
        "edge": "media"
      },
      "id": "instagram-post-com-1",
      "name": "Instagram Post",
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
