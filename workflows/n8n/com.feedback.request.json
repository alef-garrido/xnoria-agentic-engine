    {
      "parameters": {
        "jsCode": "// Exnoria - com.feedback.request\n// Send feedback follow-up to contact with ignored feedback\n\nconst webhook = $(\"Webhook\").first().json.body;\nconst contact = $input.first().json;\n\nconst { contact_id, signal_id } = webhook;\n\nconst firstname = contact.properties?.firstname?.value ?? 'Contact';\nconst lastname  = contact.properties?.lastname?.value  ?? '';\nconst email     = contact.properties?.email?.value     ?? '';\n\nconst whatsappMessage = \"Hi ${firstname}, we noticed your feedback hasn't received a response — we'd like to make it right.\";\n\nreturn [{\n  json: {\n    contact_id,\n    signal_id,\n    email,\n    firstname,\n    lastname,\n    whatsapp_message: whatsappMessage\n  }\n}];"
      },
      "id": "code-generate-message-com-3",
      "name": "Code -- generate message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Simulate -- WhatsApp message send\n// Replace with real WhatsApp API when ready\n\nconst data = $input.first().json;\n\nreturn [{\n  json: {\n    ...data,\n    message_sent: true,\n    simulated: true,\n    timestamp: Date.now()\n  }\n}];"
      },
      "id": "simulate-whatsapp-send-com-3",
      "name": "Simulate -- WhatsApp send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
