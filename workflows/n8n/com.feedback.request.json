    },
    {
      "parameters": {
        "authentication": "appToken",
        "resource": "contact",
        "operation": "get",
        "contactId": "={{ $json.body.contact_id }}",
        "additionalFields": {}
      },
      "id": "hubspot-get-contact-com-3",
      "name": "HubSpot -- get contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "credentials": {
        "hubspotAppToken": {
          "name": "HubSpot Private App"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Exnoria - com.feedback.request\n// Send feedback follow-up to contact with ignored feedback\n// Primary: email via Gmail\n\nconst webhook = $(\"Webhook\").first().json.body;\nconst contact = $input.first().json;\n\nconst { contact_id, signal_id } = webhook;\n\nconst firstname = contact.properties?.firstname?.value ?? 'Contact';\nconst lastname  = contact.properties?.lastname?.value  ?? '';\nconst email     = contact.properties?.email?.value     ?? '';\n\nconst gmail_body = 'Hi ' + firstname + ',\\n\\nWe noticed your feedback hasn\\'t received a response — we\\'d like to make it right. Please reply to this email or reach out to our team so we can address your concerns.\\n\\nBest,\\nExnoria Team';\n\nreturn [{\n  json: {\n    contact_id,\n    signal_id,\n    email,\n    firstname,\n    lastname,\n    gmail_subject: 'We value your feedback',\n    gmail_body\n  }\n}];"
      },
      "id": "code-generate-message-com-3",
      "name": "Code -- generate message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $(\"Code -- generate message\").item.json.email }}",
        "subject": "={{ $(\"Code -- generate message\").item.json.gmail_subject }}",
        "emailType": "text",
        "message": "={{ $(\"Code -- generate message\").item.json.gmail_body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "gmail-send-com-3",
      "name": "Gmail -- send feedback request",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "YMxwY3u929C0wtWe",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "appToken",
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $(\"Code -- generate message\").item.json.email }}",
        "additionalFields": {},
        "options": {}
      },
      "id": "hubspot-update-contact-com-3",
      "name": "HubSpot -- update contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "credentials": {
        "hubspotAppToken": {
          "name": "HubSpot Private App"
        }
      }
    },
    {
      "parameters": {
        "authentication": "appToken",
        "resource": "engagement",
        "operation": "create",
        "type": "task",
        "dueDate": "={{ new Date().toISOString() }}",
        "metadata": {
          "subject": "=Follow up on unacknowledged feedback from {{ $(\"Code -- generate message\").item.json.contact_id }}",
          "body": "=High-priority follow-up for unacknowledged feedback. Contact ID: {{ $(\"Code -- generate message\").item.json.contact_id }}",
          "status": "NOT_STARTED",
          "forObjectType": "CONTACT"
        }
      },
      "id": "hubspot-create-task-com-3",
      "name": "HubSpot -- create task",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ],
      "credentials": {
        "hubspotAppToken": {
          "name": "HubSpot Private App"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"executed\",\n  \"action_id\": \"com.feedback.request\",\n  \"contact_id\": \"{{ $(\"Code -- generate message\").item.json.contact_id }}\",\n  \"email_sent\": true,\n  \"task_created\": true\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-com-3",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1680,
        300
      ]
    }
  ],
