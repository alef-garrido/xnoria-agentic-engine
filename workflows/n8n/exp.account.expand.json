    {
      "parameters": {
        "jsCode": "// Exnoria - exp.account.expand\n// Branch based on signal_id to handle different expansion scenarios\n\nconst webhook = $(\"Webhook\").first().json.body;\nconst contact = $input.first().json;\n\nconst { contact_id, signal_id, signal_severity } = webhook;\n\nconst firstname = contact.properties?.firstname?.value ?? 'Contact';\nconst lastname  = contact.properties?.lastname?.value  ?? '';\nconst email     = contact.properties?.email?.value     ?? '';\n\nlet tags = [];\nlet sequenceEnrollment = null;\nlet taskSubject = null;\nlet taskPriority = 'MEDIUM';\n\n// Branch based on signal_id\nif (signal_id === 'EXP_GRW_01') {\n  // Competitor risk - flag for AE expansion review\n  tags.push('exp-competitor-risk');\n  taskSubject = `Expansion opportunity review for ${contact_id}`;\n  taskPriority = 'HIGH';\n} else if (signal_id === 'EXP_GRW_02') {\n  // Stagnant usage - trigger usage awareness campaign\n  tags.push('exp-usage-activation');\n  sequenceEnrollment = 'exp-usage-activation-sequence-id';\n  taskSubject = `Usage activation campaign for ${contact_id}`;\n}\n\nconst lastExpandAt = new Date(new Date().setUTCHours(0,0,0,0)).getTime();\n\nreturn [{\n  json: {\n    contact_id,\n    signal_id,\n    signal_severity,\n    email,\n    firstname,\n    lastname,\n    tags,\n    sequence_enrollment: sequenceEnrollment,\n    task_subject: taskSubject,\n    task_priority: taskPriority,\n    last_expand_at: lastExpandAt\n  }\n}];"
      },
      "id": "code-branching-logic-exp-1",
      "name": "Code -- branching logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "appToken",
        "email": "={{ $(\"Code -- branching logic\").item.json.email }}",
        "additionalFields": {
          "properties": [
            {
              "name": "xnoria_expansion_ready",
              "value": "true"
            },
            {
              "name": "last_exp_expand_at",
              "value": "={{ $(\"Code -- branching logic\").item.json.last_expand_at }}"
            }
          ]
        },
        "options": {}
      },
      "id": "hubspot-update-contact-exp-1",
