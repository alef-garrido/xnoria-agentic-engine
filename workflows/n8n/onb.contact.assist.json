    {
      "parameters": {
        "jsCode": "// Exnoria - onb.contact.assist\n// Build white-glove assist payload (executes after HITL approval)\n\nconst webhook = $(\"Webhook\").first().json.body;\nconst contact = $input.first().json;\n\nconst { contact_id, signal_id, signal_severity } = webhook;\nconst triggered_by = webhook.meta?.triggered_by ?? 'system';\n\nconst firstname = contact.properties?.firstname?.value ?? 'there';\nconst lastname  = contact.properties?.lastname?.value  ?? '';\nconst email     = contact.properties?.email?.value     ?? '';\nconst phone     = contact.properties?.phone?.value     ?? '';\nconst company   = contact.properties?.company?.value   ?? '';\n\nconst cleanPhone = phone.replace(/[^\\d]/g, '');\n\nconst message = [\n  'Hi ' + firstname + ',',\n  '',\n  'I noticed you might need some help getting set up \u2014 I\\'d like to personally assist you.',\n  '',\n  'Would you have 15 minutes this week for a quick call? I can walk you through everything and make sure you\\'re fully set up.',\n  '',\n  'Just reply to this message and we\\'ll get it scheduled!',\n  '',\n  '-- Your Onboarding Specialist'\n].join('\\n');\n\nconst whatsapp_payload = cleanPhone ? {\n  messaging_product: 'whatsapp',\n  to: cleanPhone,\n  type: 'text',\n  text: { body: message }\n} : null;\n\nconst assistedAt = new Date(new Date().setUTCHours(0,0,0,0)).getTime();\n\nreturn [{\n  json: {\n    contact_id,\n    signal_id,\n    signal_severity,\n    email,\n    firstname,\n    lastname,\n    company,\n    phone: cleanPhone,\n    whatsapp_payload,\n    task_subject: '[Exnoria ONB Assist] Follow up: ' + firstname + ' ' + lastname + ' - ' + company,\n    task_body: 'White-glove assist requested. Signal: ' + signal_id + ' (severity: ' + signal_severity + '). Contact: ' + email,\n    assisted_at: assistedAt\n  }\n}];"
      },
      "id": "code-assist-logic-onb4",
      "name": "Code -- assist logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
