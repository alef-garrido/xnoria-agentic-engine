        "dueDate": "={{ new Date().toISOString() }}",
        "metadata": {
          "subject": "=Document Request: {{ $json.document_type }} — {{ $json.firstname }}",
          "body": "=Please collect the following document from this contact: {{ $json.document_type }}. Contact email: {{ $json.email }}",
          "status": "NOT_STARTED",
          "forObjectType": "CONTACT"
        }
