    {
      "parameters": {
        "jsCode": "// Exnoria - onb.document.request\n// Initiate document collection request for an onboarding contact\n\nconst body    = $('Webhook').first().json.body;\nconst contact = $input.first().json;\n\nconst contact_id    = body.contact_id;\nconst signal_id     = body.signal_id ?? '';\nconst document_type = body.document_type ?? 'identity_document';\n\nconst firstname = contact.properties?.firstname?.value ?? 'Contact';\nconst email     = contact.properties?.email?.value     ?? '';\nconst ownerId   = contact.properties?.hubspot_owner_id?.value ?? null;\n\nconst requestedAt = new Date(new Date().setUTCHours(0,0,0,0)).getTime();\n\nreturn [{ json: { contact_id, signal_id, document_type, firstname, email, owner_id: ownerId, requested_at: requestedAt } }];"
      },
      "id": "code-build-doc-request",
      "name": "Code -- build doc request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "appToken",
        "resource": "engagement",
