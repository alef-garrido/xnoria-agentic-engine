{
  "name": "W-ONB-2 - Onb.document.validate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "onb-document-validate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-onb-document-validate",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "onb-document-validate"
    },
    {
      "parameters": {
        "jsCode": "// Exnoria - onb.document.validate\n// Validate a submitted onboarding document\n// contact_id, document_type, media_url (or file_url) from filter payload\n\nconst body = $json.body;\n\nconst contact_id    = body.contact_id;\nconst signal_id     = body.signal_id ?? '';\nconst document_type = body.document_type ?? 'identity_document';\nconst media_url     = body.media_url || body.file_url || '';\nconst email         = body.email ?? '';\n\nreturn [{ json: { contact_id, signal_id, document_type, media_url, email, timestamp: new Date().toISOString() } }];"
      },
      "id": "code-normalize-submission",
      "name": "Code -- normalize submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "has-media-url",
              "leftValue": "={{ !!$json.media_url }}",
              "operator": { "operation": "equals", "type": "boolean" },
              "rightValue": true
            }
          ],
          "options": { "version": 2, "caseSensitive": true, "typeValidation": "strict" }
        },
        "options": {}
      },
      "id": "if-validate-doc",
      "name": "ValidateDoc",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "authentication": "appToken",
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $('Code -- normalize submission').item.json.email }}",
        "additionalFields": {
          "customPropertiesUi": {
            "customPropertiesValues": [
              { "property": "xnoria_document_status", "value": "approved" },
              { "property": "xnoria_document_type", "value": "={{ $('Code -- normalize submission').item.json.document_type }}" },
              { "property": "xnoria_document_validated_at", "value": "={{ new Date(new Date().setUTCHours(0,0,0,0)).getTime() }}" }
            ]
          }
        }
      },
      "id": "hubspot-write-approved",
      "name": "HubSpot -- write approved",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [960, 180],
      "credentials": {
        "hubspotAppToken": { "name": "HubSpot Private App" }
      }
    },
    {
      "parameters": {
        "authentication": "appToken",
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $('Code -- normalize submission').item.json.email }}",
        "additionalFields": {
          "customPropertiesUi": {
            "customPropertiesValues": [
              { "property": "xnoria_document_status", "value": "rejected" },
              { "property": "xnoria_document_type", "value": "={{ $('Code -- normalize submission').item.json.document_type }}" },
              { "property": "xnoria_document_validated_at", "value": "={{ new Date(new Date().setUTCHours(0,0,0,0)).getTime() }}" }
            ]
          }
        }
      },
      "id": "hubspot-write-rejected",
      "name": "HubSpot -- write rejected",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [960, 420],
      "credentials": {
        "hubspotAppToken": { "name": "HubSpot Private App" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'executed', action_id: 'onb.document.validate', contact_id: $('Code -- normalize submission').item.json.contact_id, document_type: $('Code -- normalize submission').item.json.document_type, document_status: 'approved', crm_updated: true }) }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-approved",
      "name": "Respond -- approved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'executed', action_id: 'onb.document.validate', contact_id: $('Code -- normalize submission').item.json.contact_id, document_type: $('Code -- normalize submission').item.json.document_type, document_status: 'rejected', crm_updated: true }) }}",
        "options": { "responseCode": 200 }
      },
      "id": "respond-rejected",
      "name": "Respond -- rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Code -- normalize submission", "type": "main", "index": 0 }]]
    },
    "Code -- normalize submission": {
      "main": [[{ "node": "ValidateDoc", "type": "main", "index": 0 }]]
    },
    "ValidateDoc": {
      "main": [
        [{ "node": "HubSpot -- write approved", "type": "main", "index": 0 }],
        [{ "node": "HubSpot -- write rejected", "type": "main", "index": 0 }]
      ]
    },
    "HubSpot -- write approved": {
      "main": [[{ "node": "Respond -- approved", "type": "main", "index": 0 }]]
    },
    "HubSpot -- write rejected": {
      "main": [[{ "node": "Respond -- rejected", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveExecutionProgress": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "tags": ["exnoria", "onb"]
}
