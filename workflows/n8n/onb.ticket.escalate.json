      "parameters": {
        "jsCode": "// Exnoria - onb.ticket.escalate\n// Build HubSpot ticket payload for technical blocker escalation\n\nconst webhook = $(\"Webhook\").first().json.body;\nconst contact = $input.first().json;\n\nconst { contact_id, signal_id, signal_severity } = webhook;\nconst blocker_description = webhook.payload?.blocker_description ?? webhook.blocker_description ?? 'No description provided';\n\nconst firstname = contact.properties?.firstname?.value ?? 'Contact';\nconst lastname  = contact.properties?.lastname?.value  ?? '';\nconst email     = contact.properties?.email?.value     ?? '';\nconst company   = contact.properties?.company?.value   ?? '';\n\nconst escalatedAt = new Date(new Date().setUTCHours(0,0,0,0)).getTime();\n\nconst ticketTitle = 'Technical onboarding blocker \u2014 ' + firstname + ' ' + lastname + (company ? ' (' + company + ')' : '');\n\nconst ticketNote = [\n  'Escalated by Xnoria \u2014 signal ' + signal_id + ', severity ' + signal_severity,\n  '',\n  'Blocker description:',\n  blocker_description,\n  '',\n  'Contact: ' + email,\n  'Contact ID: ' + contact_id\n].join('\\n');\n\nreturn [{\n  json: {\n    contact_id,\n    signal_id,\n    signal_severity,\n    email,\n    firstname,\n    lastname,\n    company,\n    blocker_description,\n    ticket_title: ticketTitle,\n    ticket_note: ticketNote,\n    ticket_priority: 'HIGH',\n    escalated_at: escalatedAt\n  }\n}];"
      },
      "id": "code-escalation-logic-onb5",
      "name": "Code -- escalation logic",
