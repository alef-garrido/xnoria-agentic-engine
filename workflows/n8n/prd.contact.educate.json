    {
      "parameters": {
        "jsCode": "// Exnoria - prd.contact.educate\n// Feature education for contacts using workarounds (PRD_CAP_01)\n\nconst webhook = $(\"Webhook\").first().json.body;\nconst contact = $input.first().json;\n\nconst { contact_id, signal_id } = webhook;\nconst feature_area = webhook.payload?.feature_area ?? webhook.feature_area ?? 'your workflow';\n\nconst firstname = contact.properties?.firstname?.value ?? 'there';\nconst email     = contact.properties?.email?.value     ?? '';\nconst phone     = contact.properties?.phone?.value     ?? '';\n\nconst cleanPhone = phone.replace(/[^\\d]/g, '');\n\nconst message = [\n  'Hi ' + firstname + ',',\n  '',\n  'Did you know there\\'s a built-in way to handle ' + feature_area + '?',\n  '',\n  'We noticed you might be using a workaround — here\\'s a quick guide to the native feature that can save you time: [Feature Guide Link]',\n  '',\n  'Let us know if you have any questions!',\n  '',\n  '-- Exnoria Product Team'\n].join('\\n');\n\nconst whatsapp_payload = cleanPhone ? {\n  messaging_product: 'whatsapp',\n  to: cleanPhone,\n  type: 'text',\n  text: { body: message }\n} : null;\n\nconst educatedAt = new Date(new Date().setUTCHours(0,0,0,0)).getTime();\n\nreturn [{\n  json: {\n    contact_id,\n    signal_id,\n    feature_area,\n    email,\n    firstname,\n    phone: cleanPhone,\n    whatsapp_payload,\n    csm_task_subject: '[Exnoria PRD] Check in on feature adoption for ' + contact_id,\n    csm_task_body: 'Feature education sent for ' + feature_area + '. Follow up in 7 days. Signal: ' + signal_id,\n    educated_at: educatedAt\n  }\n}];"
      },
      "id": "code-educate-logic-prd2",
      "name": "Code -- educate logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.META_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($(\"Code -- educate logic\").item.json.whatsapp_payload) }}",
        "options": {}
      },
      "id": "http-meta-whatsapp-prd2",
      "name": "Meta WA -- send education",
