    {
      "parameters": {
        "jsCode": "// Exnoria - sal.contact.message\n// Send a personalized message to a SAL stage contact.\n// Primary: email via Gmail, Optional: WhatsApp (if phone available)\n\nconst body = $json.body;\n\nconst contact_id = body.contact_id;\nconst email = body.email ?? '';\nconst message = body.message ?? '';\nconst name = body.name ?? 'Contact';\nconst phone = (body.phone ?? '').replace(/[^\\d]/g, '');\nconst signal_id = body.signal_id ?? '';\n\nconst wa_payload = phone ? {\n  messaging_product: 'whatsapp',\n  to: phone,\n  type: 'text',\n  text: { body: message }\n} : null;\n\nconst gmail_subject = 'Message from Exnoria';\nconst gmail_body = 'Hello ' + name + ',\\n\\n' + message + '\\n\\n\\u2014 Exnoria';\n\nreturn [{ json: { contact_id, signal_id, phone, email, name, wa_payload, gmail_subject, gmail_body } }];"
      },
      "id": "code-build-message-sal-1",
      "name": "Code -- build message payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $env.META_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Code -- build message payload').item.json.wa_payload) }}",
        "options": {}
      },
      "id": "http-send-whatsapp-sal-1",
      "name": "Meta WA -- send message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        720,
        200
      ],
      "credentials": {
